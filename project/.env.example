# ==================== DATABASE ====================
# Também usadas por database-init (Flyway), database-undo e api
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering

# PORTA NO HOST (5433 evita conflito com um Postgres local)
POSTGRES_PORT=5433

# ======================= API ======================
SWAGGER_ENABLED=true
OTEL_ENABLED=true

# ================== SQS (MINISTACK) ===============
# Usadas por queue-init, api e worker. Credenciais falsas: o emulador aceita qualquer valor
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_PORT=4566

# ================== REVERSE PROXY =================
HTTP_PORT=8080

# ================= OTEL COLLECTOR =================
OTLP_HTTP_PORT=4318

# ===================== JAEGER =====================
JAEGER_PORT=16686

# =================== PROMETHEUS ===================
PROMETHEUS_PORT=9090

# ====================== LOKI ======================
LOKI_PORT=3100

# ===================== GRAFANA ====================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
